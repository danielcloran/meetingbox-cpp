load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Reference to the Raspberry Pi config setting
config_setting(
    name = "raspberry_pi",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)


# Create a filegroup for media resources
filegroup(
    name = "media_resources",
    srcs = glob([
        "*.png",
        "*.gif",
    ]),
    visibility = ["//visibility:public"],
)

# Audio library with Porcupine support
cc_library(
    name = "audio",
    srcs = [
        "src/audio/audio.cpp",
    ],
    hdrs = glob([
        "include/audio/**/*.hpp",
    ]),
    strip_include_prefix = "include",
    deps = [
        "//events",
        "@pocketsphinx//:pocketsphinx",
        "@fmt//:fmt",
        "@spdlog//:spdlog",
    ] + select({
        "//conditions:default": [
            "@sdl2//:sdl2",
        ],
        ":raspberry_pi": [],
    }),
    data = [
        "@pocketsphinx//:model_en_us",
        "@pocketsphinx//:dict_en_us",
    ],
    copts = [
        "-std=c++17",
    ] + select({
        "@platforms//cpu:aarch64": ["-DRASPBERRY_PI"],
        "//conditions:default": [],
    }),
    linkopts = select({
        ":raspberry_pi": ["-lSDL2"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "media_demo",
    srcs = ["src/demo.cpp"],
    deps = [":media"],
    visibility = ["//visibility:public"],
)

# Graphics library with SDL2 support
cc_library(
    name = "graphics",
    srcs = [
        "src/graphics/graphics.cpp",
    ],
    hdrs = glob([
        "include/graphics/**/*.hpp",
    ]),
    strip_include_prefix = "include",
    deps = [
        "//events",
        "@fmt//:fmt",
        "@spdlog//:spdlog",
    ] + select({
        ":raspberry_pi": ["@rpi_ws281x//:ws2811"],
        "//conditions:default": ["@sdl2//:sdl2"],
    }),
    data = [
        ":media_resources",
    ],
    copts = [
        "-std=c++17",
    ] + select({
        ":raspberry_pi": ["-DRASPBERRY_PI"],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@platforms//os:macos": [
            "-L/opt/homebrew/opt/sdl2/lib",
            "-lSDL2",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

# Media library that combines audio and graphics
cc_library(
    name = "media",
    deps = [
        ":audio",
        ":graphics",
    ],
    visibility = ["//visibility:public"],
)

# Standalone graphics test binary
cc_binary(
    name = "graphics_test",
    srcs = ["src/graphics/graphics_test_main.cpp"],
    deps = [":graphics"],
    visibility = ["//visibility:public"],
)