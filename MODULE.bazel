# Module definition for the MeetingBox Bazel build.
# This captures the external dependencies that are required to build
# the application with Bazel/Bzlmod.

module(
    name = "meetingbox",
    version = "0.1.0",
)

# Core dependencies available from the Bazel Central Registry.
bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "fmt", version = "11.0.2")
bazel_dep(name = "spdlog", version = "1.15.0")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_python", version = "1.2.0")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

# Load repository rule helpers so we can bring in dependencies
# that are not yet published to the registry.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

# SDL2 is fetched and built by Bazel (static lib, dummy video driver).
# A fresh clone does not need libsdl2-dev, Homebrew SDL, or a committed framework.
http_archive(
    name = "sdl2",
    build_file = "//third_party:sdl2.BUILD",
    sha256 = "f5c2b52498785858f3de1e2996eba3c1b805d08fe168a47ea527c7fc339072d0",
    strip_prefix = "SDL2-2.32.0",
    urls = ["https://github.com/libsdl-org/SDL/releases/download/release-2.32.0/SDL2-2.32.0.tar.gz"],
)

# rpi_ws281x library for WS2812B LED control
git_repository(
    name = "rpi_ws281x",
    remote = "https://github.com/jgarff/rpi_ws281x.git",
    commit = "7fc8914ba08f862351ab64c810c9d31190cf6c1a",  # Pin to a recent commit
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "ws2811",
    srcs = glob(["*.c"]),
    hdrs = glob(["*.h"]),
    includes = ["."],
    visibility = ["//visibility:public"],
)
""",
)

# Header-only event dispatcher library.
git_repository(
    name = "eventpp",
    remote = "https://github.com/wqking/eventpp.git",
    tag = "v0.1.2",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "eventpp",
    hdrs = glob(["include/eventpp/**/*.h"]),
    includes = ["include"],
)
""",
)

# JsonCpp serialization library.
git_repository(
    name = "jsoncpp",
    remote = "https://github.com/open-source-parsers/jsoncpp.git",
    tag = "1.9.5",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "jsoncpp",
    srcs = glob(["src/lib_json/*.cpp"]),
    hdrs = glob(["include/json/**/*.h"]) + glob(["src/lib_json/*.h"]) + glob(["src/lib_json/*.inl"]),
    includes = ["include", "src/lib_json"],
    copts = ["-Wno-implicit-fallthrough", "-DJSON_USE_EXCEPTION=0"],
)
""",
)

# PocketSphinx (v5.0.3)
http_archive(
    name = "pocketsphinx",
    build_file = "//third_party:pocketsphinx.BUILD",
    sha256 = "5d952cb1c22e0a51ed1fafc36871612df38f145df64fa017fdc8074532ec007f",
    strip_prefix = "pocketsphinx-5.0.3",
    urls = ["https://github.com/cmusphinx/pocketsphinx/archive/refs/tags/v5.0.3.tar.gz"],
)
