load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

# Timer clock and countdown. Graphics only — no audio, hotword, or PocketSphinx.
cc_library(
    name = "timer",
    srcs = [
        "processes/timer.cpp",
        "utils/interrupt_timer.cpp",
    ],
    copts = ["-std=c++17"],
    deps = [
        "//events",
        "//include:headers",
        "//media:graphics",
        "@jsoncpp//:jsoncpp",
    ],
)

cc_library(
    name = "timer_demo_lib",
    srcs = [
        "gif_writer.cpp",
        "timer_demo.cpp",
    ],
    hdrs = ["gif_writer.hpp"],
    copts = ["-std=c++17"],
    deps = [
        ":timer",
        "//include:headers",
        "//media:graphics",
        "//media:SdlRenderer",
        "@jsoncpp//:jsoncpp",
    ],
)

cc_library(
    name = "meetingbox_core",
    srcs = [
        "processes/hotword_detected.cpp",
        "processes/process_manager.cpp",
        "processes/screensaver_simple.cpp",
    ],
    deps = [
        ":timer",
        "//include:headers",
        "//events",
        "//media",
        "@jsoncpp//:jsoncpp",
    ],
    copts = ["-std=c++17"],
)

cc_binary(
    name = "timer_demo",
    srcs = ["timer_demo_main.cpp"],
    copts = ["-std=c++17"],
    linkopts = ["-pthread"],
    deps = [":timer_demo_lib"],
)

cc_binary(
    name = "meetingbox",
    srcs = ["main.cpp"],
    deps = [
        ":meetingbox_core",
        ":timer_demo_lib",
    ],
    copts = ["-std=c++17"],
    linkopts = ["-pthread"],
)

# Focused LED host plus a newline-delimited MCP stdio server.
# Present path is //media:present, one control plane either way:
#   //media:raspberry_pi (linux aarch64) -> //media:RpiRenderer
#       HUB75 panels, rpi-rgb-led-matrix, FM6126A. This is the product.
#   default -> //media:SdlRenderer
#       SDL window or dummy driver. Demo and default-host only.
# WS281x is not selected. Mic/hotword stays on //media:audio.
cc_library(
    name = "timebox_host",
    srcs = [
        "timebox/host.cpp",
        "timebox/mcp.cpp",
    ],
    copts = ["-std=c++17"],
    linkopts = ["-pthread"],
    deps = [
        ":timer",
        "//include:headers",
        "//media:graphics",
        "//media:present",
        "@jsoncpp//:jsoncpp",
    ],
)

alias(
    name = "RpiRenderer",
    actual = "//media:RpiRenderer",
)

alias(
    name = "SdlRenderer",
    actual = "//media:SdlRenderer",
)

cc_binary(
    name = "timebox_mcp",
    srcs = ["timebox/mcp_main.cpp"],
    copts = ["-std=c++17"],
    linkopts = ["-pthread"],
    deps = [":timebox_host"],
)

cc_test(
    name = "timebox_host_test",
    size = "small",
    srcs = ["timebox/host_test.cpp"],
    copts = ["-std=c++17"],
    linkopts = ["-pthread"],
    deps = [
        ":timebox_host",
        "//media:graphics",
        "@jsoncpp//:jsoncpp",
    ],
)
